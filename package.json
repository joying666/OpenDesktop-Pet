{
  "name": "open-desktop-pet",
  "version": "1.0.0",
  "description": "OpenDesktop-Pet",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.desktop.pet",
    "productName": "OpenDesktop-Pet",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "portable": {
        "requestExecutionLevel": "asInvoker"
      }
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
